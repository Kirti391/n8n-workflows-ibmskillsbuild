        "jsCode": "const hours_old = $json[\"hours_old\"];\nconst food = ($json[\"food_type\"] || \"\").toLowerCase();\nconst condition = ($json[\"condition\"] || \"\").toLowerCase();\nconst foodCategory = ($json[\"food_category\"] || \"\").toLowerCase();\n\n// broadened classification\nconst rawFoods = [\"vegetables\", \"fruits\", \"tomato\", \"tomatoes\", \"onion\", \"potato\", \"leafy greens\"];\nconst cookedFoods = [\"cooked rice\", \"dal\", \"chapati\"];\n\n// helper checks\nconst isRawFood = rawFoods.some(f => food.includes(f));\nconst isFresh = condition === \"fresh\" || foodCategory === \"raw\";\n\n// RULES (priority matters)\n\n// 1. Human donation: fresh + raw + safe time window\nif (hours_old <= 6 && isRawFood && isFresh) {\n  category = \"human\";\n  action = \"donate\";\n\n// 2. Cooked but still fresh\n} else if (hours_old <= 4 && cookedFoods.includes(food)) {\n  category = \"human\";\n  action = \"donate\";\n\n// 3. Animal feed fallback\n} else if (hours_old <= 6 && isRawFood) {\n  category = \"animal\";\n  action = \"feed farm\";\n\n// 4. Waste only if not safe\n} else {\n  category = \"waste\";\n  action = \"compost\";\n}\n\nreturn [{ json: { ...$json, category, action } }];"
